CHANNEL_HANDLE=@MyChannel
ACTIVE_PROFILE=default_psychology
UPLOAD_PRIVACY=private

# --- 100% FREE ZERO-COST DEFAULTS ---
# TTS: Uses Edge-TTS out of the box (No API key required)
